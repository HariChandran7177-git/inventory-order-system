# ==============================================================================
# INVENTORY ORDER SYSTEM CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Redis Configuration (Used by Inventory Service and Payment Service)
# ------------------------------------------------------------------------------
# Hostname or IP of the Redis server (default: localhost)
REDIS_HOST=localhost

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis password (leave blank if password authentication is not configured)
REDIS_PASSWORD=

# Inventory stream consumer settings
INVENTORY_STREAM_KEY=order_completed
INVENTORY_CONSUMER_GROUP=inventory_group
INVENTORY_CONSUMER_NAME=inventory_consumer_1

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Used by Payment Service)
# ------------------------------------------------------------------------------
# Hostname or IP of PostgreSQL (default: localhost)
POSTGRES_HOST=localhost

# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# PostgreSQL username
POSTGRES_USERNAME=postgres

# PostgreSQL password
POSTGRES_PASSWORD=password

# PostgreSQL database name
POSTGRES_DATABASE=postgres

# SQL statement logging is verbose and may include application data.
SQL_ECHO=false

# ------------------------------------------------------------------------------
# Inter-Service Communication URLs
# ------------------------------------------------------------------------------
# Comma-separated browser origins allowed by both APIs. Keep production values
# restricted to the exact frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# URL for the Inventory API (used by Payment Service for product validation & stock checks)
INVENTORY_SERVICE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Service Host Port Bindings
# ------------------------------------------------------------------------------
# Host port for Inventory API (default: 8000)
INVENTORY_API_PORT=8000

# Host port mapping for Payment API (default: 8001)
PAYMENT_API_PORT=8001

# Host port mapping for Frontend Vite Dev Server (default: 3000)
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite environment variables)
# Note: In Vite, variables prefixed with VITE_ are embedded into client bundles.
# ------------------------------------------------------------------------------
# Inventory API base URL accessed by the browser
VITE_API_URL=http://localhost:8000

# Payment API base URL accessed by the browser
VITE_PAYMENT_API_URL=http://localhost:8001
